# --- Google Apps Script (Google Sheet) ---
# URL ของ Web app ที่ deploy จาก google-apps-script/Code.gs (ลงท้ายด้วย /exec)
GOOGLE_SCRIPT_URL=
# รหัสลับ ต้องตรงกับ Script Property "SECRET" ใน Apps Script
GOOGLE_SCRIPT_SECRET=

# --- ร้าน ---
# ราคาแพ็กเกจ (บาท)
NEXT_PUBLIC_PRICE=69
# เบอร์โทร/เลขบัตรประชาชนพร้อมเพย์ — ว่างไว้ = ใช้รูป public/payment-qr.jpg
NEXT_PUBLIC_PROMPTPAY_ID=
# ช่องทางติดต่อ (โชว์ท้ายเว็บ) เช่น IG @polaroid888
NEXT_PUBLIC_CONTACT= @polaroid888

# --- ช่วงวันที่เปิดรับจอง (YYYY-MM-DD) ไม่ตั้ง = ทุกวันตั้งแต่วันนี้ ---
NEXT_PUBLIC_START_DATE=
NEXT_PUBLIC_END_DATE=2026-11-12
NEXT_PUBLIC_DAYS_AHEAD=30
